{
  "name": "@jaz-w/shiyu-shutu-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "clean": "rimraf dist pnpm-lock.yaml node_modules",
    "check:types": "vue-tsc --noEmit",
    "dev": "vite",
    "build:dev": "vite build --mode development",
    "build:pro": "vite build",
    "preview": "vite preview --port 8080",
    "prettier": "prettier --write .",
    "lint": "eslint --fix .",
    "lint:style": "stylelint --fix **/*.{vue,html,css}",
    "commit": "git-cz"
  },
  "engines": {
    "node": ">=14.16.0"
  },
  "dependencies": {
    "@vueuse/core": "^13.9.0",
    "axios": "^1.12.2",
    "dayjs": "^1.11.13",
    "naive-ui": "^2.43.1",
    "normalize.css": "^8.0.1",
    "pinia": "^3.0.3",
    "pinyin": "4.0.0",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@iconify-json/el": "^1.2.2",
    "@iconify-json/eos-icons": "^1.2.4",
    "@iconify-json/fe": "^1.2.4",
    "@iconify-json/icon-park-outline": "^1.2.4",
    "@iconify-json/iconoir": "^1.2.9",
    "@iconify-json/line-md": "^1.2.11",
    "@iconify-json/logos": "^1.2.9",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify/vue": "^4.0.0",
    "@types/clone": "^2.1.4",
    "@unocss/preset-uno": "^0.45.22",
    "@unocss/vite": "^0.45.22",
    "@vitejs/plugin-vue": "^2.3.4",
    "@vitejs/plugin-vue-jsx": "^1.3.10",
    "@vue/runtime-core": "^3.2.39",
    "autoprefixer": "^10.4.11",
    "commitizen": "^4.2.5",
    "cz-emoji-conventional": "^1.0.1",
    "eslint": "^8.56.0",
    "happy-dom": "^7.0.0",
    "highlight.js": "^11.6.0",
    "lint-staged": "^13.0.3",
    "postcss": "catalog:frontend",
    "prettier": "catalog",
    "rollup-plugin-visualizer": "^5.8.1",
    "sass": "^1.55.0",
    "stylelint": "^16.14.0",
    "unplugin-auto-import": "^0.9.5",
    "unplugin-icons": "^0.14.10",
    "unplugin-vue-components": "^0.21.2",
    "unplugin-vue-macros": "^0.11.2",
    "vite-plugin-html": "^3.2.0",
    "vite-plugin-inspect": "0.5.0",
    "vite-plugin-md": "^0.18.0",
    "vue-tsc": "^0.34.17"
  },
  "lint-staged": {
    "**/*.{js,ts,tsx,vue}": "eslint --fix",
    "**/*.{vue,html,css}": "stylelint --fix",
    "**/*.{js,ts,tsx,md,html,vue,css}": "prettier --write"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-emoji-conventional"
    }
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": []
    }
  }
}
