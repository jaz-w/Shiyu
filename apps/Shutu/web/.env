# README: .env 只展示默认值，实际开发环境请根据实际情况修改 .env.* 文件

# ----------------- SEO -----------------
#站点标题
VITE_APP_TITLE = 枢途

# 站点描述
VITE_APP_DESCRIPTION =

# 站点关键词
VITE_APP_KEYWORDS =

# 站点审计 地址
VITE_APP_AUDIT_URL =

# 站点审计 ID
VITE_APP_AUDIT_ID =

# ---------------- Deploy -----------------
# 站点的域名
VITE_DEPLOY_WEBSITE =

# 站点服务启动的端口
VITE_DEPLOY_PORT = 8080

# ----------------- API -----------------
# 基础
VITE_API_URL =

# 审计相关
VITE_API_AUDIT_URL =

# 本地开发阶段代理的服务的前缀 - 基础
VITE_PROXY_API_PREFIX = /proxy-base

# 本地开发阶段代理的服务的前缀 - 审计相关
VITE_PROXY_API_AUDIT_PREFIX = /proxy-audit

# 本地开发阶段代理的服务,末尾别带逗号,支持读取`VITE_`环境变量,写法`$VITE_XXX`
VITE_PROXY_API_URL = [["$VITE_PROXY_API_PREFIX", "$VITE_API_URL"], ["$VITE_PROXY_API_AUDIT_PREFIX", "$VITE_API_AUDIT_URL"]]

# ----------------- Security And SSL  -----------------
# 是否开启接口传输加密 - 'Y' | 'N'
VITE_REQUEST_SECURITY = Y

# 是否开启接口响应解密 - 'Y' | 'N'
VITE_RESPONSE_SECURITY = Y

# 受信任的域名
VITE_TRUST_HOSTNAMES = []

# 证书配置 - 证书文件路径
VITE_SSL_CERTIFICATE =

# 私钥配置 - 私钥文件路径
VITE_SSL_PRIVATE_KEY =

# CA证书配置 - CA证书文件路径
VITE_SSL_CA_CERTIFICATE =

# ----------------- 本地开发 -----------------
# 是否 在本地开发阶段代理服务请求 - 'Y' | 'N'
VITE_PROXY_API = N

# 是否开启MOCK - 优先级大于代理 - 'Y' | 'N'
VITE_MOCK = N

# 是否 开启打包结果分析 - 'Y' | 'N'
VITE_VISUALIZER = N

