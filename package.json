{
  "name": "shiyu-monorepo",
  "version": "0.0.0",
  "description": "时屿",
  "bugs": "https://github.com/jaz-w/Shiyu/issues",
  "repository": "https://github.com/jaz-w/Shiyu.git",
  "license": "MIT",
  "author": {
    "name": "JazWang",
    "url": "https://github.com/jaz-w"
  },
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=8192 turbo build",
    "build:docker": "./scripts/deploy/build-local-docker-image.sh",
    "build:analyze": "turbo build:analyze",
    "build:playground": "pnpm --filter @jaz-w/shiyu-playground build",
    "changeset": "pnpm exec changeset",
    "check": "pnpm run check:circular && pnpm run check:dep && pnpm run check:type && pnpm check:cspell",
    "check:circular": "vsh check-circular",
    "check:cspell": "cspell lint **/*.ts **/README.md .changeset/*.md --no-progress",
    "check:dep": "vsh check-dep",
    "check:type": "turbo run typecheck",
    "clean": "node ./scripts/clean.mjs",
    "commit": "czg",
    "dev": "turbo-run dev",
    "dev:playground": "pnpm --filter @jaz-w/shiyu-playground dev",
    "format": "vsh lint --format",
    "lint": "vsh lint",
    "addrepo": "vsh addrepo",
    "postinstall": "pnpm -r run stub --if-present",
    "preinstall": "npx only-allow pnpm",
    "preview": "turbo-run preview",
    "publint": "vsh publint",
    "reinstall": "pnpm clean --del-lock && pnpm install",
    "test:unit": "vitest run --dom",
    "test:e2e": "turbo run test:e2e",
    "update:deps": "npx taze -r -w",
    "version": "pnpm exec changeset version && pnpm install --no-frozen-lockfile"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.5.1",
    "@changesets/cli": "^2.29.2",
    "@jaz-w/shiyu-commitlint-config": "workspace:*",
    "@jaz-w/shiyu-eslint-config": "workspace:*",
    "@jaz-w/shiyu-node-utils": "workspace:*",
    "@jaz-w/shiyu-playground": "workspace:*",
    "@jaz-w/shiyu-prettier-config": "workspace:*",
    "@jaz-w/shiyu-stylelint-config": "workspace:*",
    "@jaz-w/shiyu-tsconfig": "workspace:*",
    "@jaz-w/shiyu-turbo-run": "workspace:*",
    "@jaz-w/shiyu-types": "workspace:*",
    "@jaz-w/shiyu-unocss-config": "workspace:*",
    "@jaz-w/shiyu-utils": "workspace:*",
    "@jaz-w/shiyu-vite-config": "workspace:*",
    "@jaz-w/shiyu-vsh": "workspace:*",
    "@types/node": "catalog:",
    "cross-env": "catalog:",
    "cspell": "^8.19.3",
    "glob": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.1",
    "rimraf": "catalog:",
    "turbo": "^2.5.2",
    "typescript": "catalog:",
    "unbuild": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.20.0",
    "pnpm": ">=9.15.0"
  },
  "packageManager": "pnpm@9.15.9"
}
