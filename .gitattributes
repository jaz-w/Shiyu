# 默认：自动识别文本文件，并统一换行符为 LF
* text=auto eol=lf

# 强制某些脚本/配置文件一定是 LF（避免有人系统配置乱了）
*.sh   text eol=lf
*.bash text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.jsx  text eol=lf

# Windows 专用文件可以强制 CRLF（如果项目里有的话）
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制文件保持原样（不做任何行尾转换）
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.jar  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
